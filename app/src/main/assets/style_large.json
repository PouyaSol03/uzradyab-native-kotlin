{
  "version": 8,
  "name": "Uzradyab Vector Style",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://map.exirfirm.com/data/v3.json"
    }
  },
  "sprite": "https://map.exirfirm.com/sprites/sprite",
  "glyphs": "https://map.exirfirm.com/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "place_country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "==",
        "class",
        "country"
      ],
      "layout": {
        "text-field": "{name_fa}",
        "text-font": [
          "IRANSans-Bold"
        ],
        "text-size": 42
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "==",
        "class",
        "city"
      ],
      "layout": {
        "text-field": "{name_fa}",
        "text-font": [
          "IRANSans-Regular"
        ],
        "text-size": {
          "base": 1.2,
          "stops": [
            [
              7,
              25
            ],
            [
              12,
              35
            ],
            [
              16,
              67.5
            ]
          ]
        }
      },
      "paint": {
        "text-color": "#222222",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": "{name_fa}",
        "text-font": [
          "IRANSans-Medium"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          22.5,
          18,
          56.25
        ]
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "layout": {
        "text-field": "{name_fa}",
        "text-font": [
          "IRANSans-Regular"
        ],
        "text-size": {
          "stops": [
            [
              14,
              28.12
            ],
            [
              19,
              48.75
            ]
          ]
        }
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.7
      }
    }
  ]
}