    fun String.toPersianDigits(): String {
        val persianDigits = charArrayOf(\'۰\', \'۱\', \'۲\', \'۳\', \'۴\', \'۵\', \'۶\', \'۷\', \'۸\', \'۹\')
        val chars = this.toCharArray()
        for (i in chars.indices) {
            val char = chars[i]
            if (char in \'0\'..\'9\') {
                chars[i] = persianDigits[char - \'0\']
            }
        }
        return String(chars)
    }
    
